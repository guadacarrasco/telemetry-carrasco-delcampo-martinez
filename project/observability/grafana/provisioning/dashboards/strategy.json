{
  "title": "F1 Race Strategy",
  "uid": "f1-strategy",
  "tags": ["f1", "strategy"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "session_key",
        "type": "textbox",
        "label": "Session Key",
        "hide": 0,
        "current": { "selected": true, "text": "9662", "value": "9662" },
        "options": [{ "selected": true, "text": "9662", "value": "9662" }],
        "query": "9662",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Gap to Race Leader (seconds)",
      "description": "Cumulative time gap between each driver and the race leader. 0 = leader.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "asc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_gap_to_leader_seconds{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Pit Stops Over Time",
      "description": "Cumulative pit stops per driver — steps indicate when pits occurred.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_pit_stops_total{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 3,
      "title": "Total Pit Stops (current)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_pit_stops_total{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Tyre Compound (laps on current set)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Ferrari.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ED1131" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*McLaren.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F47600" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Red Bull.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4781D7" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Mercedes.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00D7B6" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Aston Martin.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#229971" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Audi.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A9B4C2" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Williams.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1868DB" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Alpine.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00A1E8" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Racing Bulls.*|.*Visa Cash App.*|.*VCARB.*|\\(RB\\)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#6C98FF" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Haas.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#EB0A1E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Kick Sauber.*|.*Sauber.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#01C00E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Cadillac.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#909090" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "right", "limit": 10 }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_tyre_life_laps{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}}) — {{compound}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Laps Completed Over Time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_laps_completed{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}})",
          "refId": "A"
        }
      ]
    }
  ]
}
