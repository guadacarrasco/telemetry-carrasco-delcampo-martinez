{
  "title": "F1 Live Race",
  "uid": "f1-live-race",
  "tags": ["f1", "race"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "session_key",
        "type": "textbox",
        "label": "Session Key",
        "hide": 0,
        "current": { "selected": true, "text": "9662", "value": "9662" },
        "options": [{ "selected": true, "text": "9662", "value": "9662" }],
        "query": "9662",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Simulation Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Idle", "color": "orange" },
                "1": { "text": "Running", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(f1_simulation_active{session_key=\"$session_key\"}) or vector(0)",
          "legendFormat": "Status",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Drivers Reporting",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(f1_driver_position{session_key=\"$session_key\"})",
          "legendFormat": "Drivers",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Leader",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "gold", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_position{session_key=\"$session_key\", position=\"1\"} or (f1_driver_position{session_key=\"$session_key\"} == 1)",
          "legendFormat": "{{acronym}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Race Positions Over Time (lower = better)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "asc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_position{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}})",
          "refId": "A"
        }
      ],
      "transformations": []
    },
    {
      "type": "xychart",
      "id": 7,
      "title": "Circuit Layout",
      "description": "Track outline from OpenF1 location data. Run ingest then start a simulation to load the circuit.",
      "gridPos": { "h": 16, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": { "pointSize": 4, "lineWidth": 0, "hideFrom": { "legend": true, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "options": {
        "xField": "x",
        "series": [{ "name": "y", "y": "y" }],
        "mapping": "manual",
        "dims": { "x": "x", "exclude": [] },
        "tooltip": { "mode": "none" },
        "legend": { "displayMode": "hidden" }
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        { "id": "joinByField", "options": { "byField": "idx", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "renameByName": { "Value": "x", "Value 1": "y" },
            "excludeByName": { "Time": true, "__name__": true, "session_key": true, "instance": true, "job": true }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_track_x{session_key=\"$session_key\"}",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{idx}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_track_y{session_key=\"$session_key\"}",
          "instant": true,
          "refId": "B",
          "legendFormat": "{{idx}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 5,
      "title": "Current Laps Completed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_laps_completed{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 6,
      "title": "Pit Stops",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_pit_stops_total{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}}",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
