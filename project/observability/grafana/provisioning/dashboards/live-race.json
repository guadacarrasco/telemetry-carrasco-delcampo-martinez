{
  "title": "F1 Live Race",
  "uid": "f1-live-race",
  "tags": ["f1", "race"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "session_key",
        "type": "textbox",
        "label": "Session Key",
        "hide": 0,
        "current": { "selected": true, "text": "9662", "value": "9662" },
        "options": [{ "selected": true, "text": "9662", "value": "9662" }],
        "query": "9662",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "id": 10,
      "title": "Circuit",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_session_info{session_key=\"$session_key\"}",
          "legendFormat": "{{circuit}}, {{country}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Session Type",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_session_info{session_key=\"$session_key\"}",
          "legendFormat": "{{session_type}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Date",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_session_info{session_key=\"$session_key\"}",
          "legendFormat": "{{date_start}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Simulation Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Finished", "color": "blue" },
                "1": { "text": "Running", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(f1_simulation_active{session_key=\"$session_key\"}) or vector(0)",
          "legendFormat": "Status",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Drivers Reporting",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(f1_driver_position{session_key=\"$session_key\"})",
          "legendFormat": "Drivers",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Leader",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "gold", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_position{session_key=\"$session_key\", position=\"1\"} or (f1_driver_position{session_key=\"$session_key\"} == 1)",
          "legendFormat": "{{acronym}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Race Positions Over Time",
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 1,
          "max": 20,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Ferrari.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ED1131" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*McLaren.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F47600" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Red Bull.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4781D7" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Mercedes.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00D7B6" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Aston Martin.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#229971" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Audi.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A9B4C2" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Williams.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1868DB" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Alpine.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00A1E8" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Racing Bulls.*|.*Visa Cash App.*|.*VCARB.*|\\(RB\\)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#6C98FF" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Haas.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#EB0A1E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Kick Sauber.*|.*Sauber.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#01C00E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Cadillac.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#909090" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "asc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_position{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}})",
          "refId": "A"
        }
      ],
      "transformations": []
    },
    {
      "type": "bargauge",
      "id": 5,
      "title": "Current Laps Completed",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Ferrari.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ED1131" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*McLaren.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F47600" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Red Bull.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4781D7" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Mercedes.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00D7B6" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Aston Martin.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#229971" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Audi.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A9B4C2" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Williams.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1868DB" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Alpine.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00A1E8" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Racing Bulls.*|.*Visa Cash App.*|.*VCARB.*|\\(RB\\)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#6C98FF" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Haas.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#EB0A1E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Kick Sauber.*|.*Sauber.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#01C00E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Cadillac.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#909090" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_laps_completed{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 6,
      "title": "Pit Stops",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Ferrari.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ED1131" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*McLaren.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F47600" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Red Bull.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4781D7" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Mercedes.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00D7B6" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Aston Martin.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#229971" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Audi.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A9B4C2" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Williams.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1868DB" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Alpine.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00A1E8" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Racing Bulls.*|.*Visa Cash App.*|.*VCARB.*|\\(RB\\)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#6C98FF" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Haas.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#EB0A1E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Kick Sauber.*|.*Sauber.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#01C00E" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*Cadillac.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#909090" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "f1_driver_pit_stops_total{session_key=\"$session_key\"}",
          "legendFormat": "{{acronym}} ({{team}})",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
