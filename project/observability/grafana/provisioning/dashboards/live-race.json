      "options": {
        "mode": "html",
        "content": "<style>@keyframes f1PR{0%{transform:scale(.7);opacity:.5}80%{transform:scale(1.8);opacity:0}100%{transform:scale(.7);opacity:0}}@keyframes f1PD{0%{transform:scale(.96)}50%{transform:scale(1.04)}100%{transform:scale(.96)}}</style><div id=\"f1sl\" style=\"display:none;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:10px\"><div style=\"position:relative;width:16px;height:16px\"><div style=\"position:absolute;inset:-7px;border-radius:50%;background:rgba(34,197,94,.2);animation:f1PR 1.8s ease-out infinite\"></div><div style=\"position:absolute;inset:0;border-radius:50%;background:#22c55e;animation:f1PD 1.8s ease-in-out infinite\"></div></div><p style=\"font-size:11px;color:#22c55e;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin:0\">LIVE</p></div><div id=\"f1se\" style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:10px\"><p style=\"font-size:13px;color:#6b7280;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin:0\">ENDED</p></div><script>(function(){var SK='f1sim_$session_key';function apply(on){var el=document.getElementById('f1sl');var el2=document.getElementById('f1se');if(el)el.style.display=on?'flex':'none';if(el2)el2.style.display=on?'none':'flex';}var c=localStorage.getItem(SK);if(c!==null)apply(c==='1');(function poll(){fetch('/api/datasources/proxy/uid/prometheus/api/v1/query?query='+encodeURIComponent('f1_simulation_active{session_key=\"$session_key\"}')).then(function(r){return r.json()}).then(function(d){var r=d&&d.data&&d.data.result;var on=Array.isArray(r)&&r.length>0&&r[0].value[1]==='1';localStorage.setItem(SK,on?'1':'0');apply(on);}).catch(function(){});setTimeout(poll,5000);})();})();<\/script>",
